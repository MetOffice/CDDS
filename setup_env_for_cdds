#!/usr/bin/env bash

if [ $# -ne 1 ]; then
    echo "Usage: $BASH_SOURCE <version>, where <version> is, e.g. 1.0.0"
    return 1
fi

CDDS="cdds-"$1

if [[ "$(hostname -f)" =~ "jasmin" ]]; then
    CONDA=~cdds/software/miniforge3/bin/activate 
else
    CONDA=/opt/conda/bin/activate
fi

source "$CONDA" ~cdds/conda_environments/"$CDDS" || return $?

# Run check for latest version of CDDS available:
# (Runs only in interactive shells, not cylc workflows).
if [[ $- == *i* ]]; then
    # Suppress import errors for older versions without checker;
    # run the checker if its module is available.
    if python -c "import cdds.misc.check_latest_version_available" >/dev/null 2>&1; then
        python -m cdds.misc.check_latest_version_available "$1" ~cdds/conda_environments
    fi
fi