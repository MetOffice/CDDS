#!/usr/bin/env bash

if [ $# -ne 1 ]; then
    echo "Usage: $BASH_SOURCE <version>, where <version> is, e.g. 1.0.0"
    return 1
fi

CDDS="cdds-"$1

if [[ "$(hostname -f)" =~ "jasmin" ]]; then
    CONDA=~cdds/software/miniforge3/bin/activate 
else
    CONDA=/opt/conda/bin/activate
fi

source "$CONDA" ~cdds/conda_environments/"$CDDS" || return $?

# Show the version notice only in interactive shells, not automated workflows.
if [[ $- == *i* ]]; then
    # Skip the check when using an older version of CDDS that does not contain the checker.
    if command -v cdds_check_latest_version >/dev/null 2>&1; then
        if ! cdds_check_latest_version; then
            echo "Unable to verify the latest CDDS version." >&2
        fi
    fi
fi

return 0
